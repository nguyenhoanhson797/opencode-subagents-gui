{
  "name": "opencode-subagents-gui",
  "version": "0.1.0",
  "type": "module",
  "description": "Create, edit, override and track OpenCode subagents from an OpenCode Desktop side panel.",
  "license": "MIT",
  "author": "opencode-subagents-gui contributors",
  "homepage": "https://github.com/nguyenhoanhson797/opencode-subagents-gui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenhoanhson797/opencode-subagents-gui.git"
  },
  "bugs": {
    "url": "https://github.com/nguyenhoanhson797/opencode-subagents-gui/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "desktop",
    "gui",
    "agents",
    "subagents"
  ],
  "packageManager": "pnpm@11.9.0",
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/server/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "selftest": "node scripts/selftest.mjs",
    "preview": "vite --config preview/vite.config.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@types/node": "^22.20.5",
    "effect": "4.1.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.8"
  }
}
